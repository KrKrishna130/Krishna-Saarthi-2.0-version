PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:4b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
PROJECT_MAX_CHARS=10000
RESUME_MAX_CHARS=16000
WHISPER_MODEL=base.en
SPEECH_LANGUAGE=en
AUDIO_DEVICE=
MAX_ANSWER_TOKENS=450
MODEL_TIMEOUT_SECONDS=120
FALLBACK_MESSAGE=The model could not return a response. Check your model, connection and configuration, then retry.

WEB_PORT=8787
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Native Electron launcher running on your laptop
DESKTOP_URL=http://localhost:8787
SHORTCUT_LEFT=Control+Left
SHORTCUT_RIGHT=Control+Right
SHORTCUT_TOGGLE=Control+H

# Floating meeting companion window
DESKTOP_ALWAYS_ON_TOP=true
DESKTOP_CONTENT_PROTECTION=true

# Hide the Electron window's Windows taskbar button.
# Restore with Control+H or rerun Open-UI-Windows.wsf.
DESKTOP_SKIP_TASKBAR=true

# Retain only the latest audio window in memory while the session stays active.
AUDIO_WINDOW_SECONDS=60
